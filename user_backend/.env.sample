# режим отладки
DEBUG=True
# секретный ключ Django (можно сгенерировать, например, на https://djecrety.ir)
SECRET_KEY=secret_key
# список хостов/доменов, для которых может работать сайт
ALLOWED_HOSTS=0.0.0.0,localhost,127.0.0.1

# реквизиты подключения к СУБД PostgreSQL
POSTGRES_DB=ecg_db
POSTGRES_USER=ecg_user
POSTGRES_PASSWORD=secret

# строка подключения к БД
DATABASE_URL=postgres://ecg_user:secret@db/ecg

# подключение к хранилищу
MINIO_ACCESS_KEY_ID=user
MINIO_SECRET_ACCESS_KEY=password
MINIO_STORAGE_BUCKET_NAME=static
MINIO_API=http://minio:9000

# Label Studio
LABEL_STUDIO_TOKEN=
LABEL_STUDIO_SYNC=http://host.docker.internal:8080/api/storages/s3/1/sync

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
